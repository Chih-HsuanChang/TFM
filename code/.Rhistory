),
polarization = replace(polarization, polarization %in% 96:99, "NA"),
polarization = factor(polarization,
levels = c(0, 1)
),
across(line:youtube, as.factor),
t_tvn = case_when(
t_tvn %in% c(9999, 998, 997, 9996) ~ NA,
TRUE ~ t_tvn
),
t_papern = case_when(
t_papern %in% c(9999, 998, 997, 9996) ~ NA,
TRUE ~ t_papern
),
t_broadcastn = case_when(
t_broadcastn %in% c(9999, 998, 997, 9996) ~ NA,
TRUE ~ t_broadcastn
),
t_magn = case_when(
t_magn %in% c(9999, 998, 997, 9996) ~ NA,
TRUE ~ t_magn
),
t_onlinen = case_when(
t_onlinen %in% c(9999, 998, 997, 9996) ~ NA,
TRUE ~ t_onlinen
),
across(t_tvn:t_onlinen, as.numeric),
)
df <- data %>%
mutate(income_num = as.numeric(income))
weighted_cuts <- wtd.quantile(
df$income,
weights = df$wr_report,
probs = seq(0, 1, by = 0.25)
)
df <- df %>%
mutate(
income_quantile = cut(
income_num,
breaks = weighted_cuts,
include.lowest = TRUE,
# Add clear, descriptive labels for your model output
labels = c(1:4)
),
# Ensure it is an ordered factor for multiple imputation and regression
income_quantile = factor(income_quantile, ordered = FALSE)
) %>%
select(-income_num) # Clean up the temporary numeric column
data$income_quantile <- df$income_quantile
data <- data |>
select(-income) |>
relocate(income_quantile, .before = line)
platform_vars <- c("line", "fb", "ig", "x", "tiktok", "dcard", "ptt", "threads",  "youtube")
data <- data |>
mutate(dplyr::across(
dplyr::all_of(platform_vars),
~ as.numeric(as.character(.))
)) |>
rowwise() |>
mutate(
breadth = sum(dplyr::c_across(dplyr::all_of(platform_vars)))
) %>%
ungroup()
lwd_data <- data |> drop_na()
lwd_data_rep <- lwd_data %>%
rowwise() %>%
mutate(
rep_label = paste(platform_vars[dplyr::c_across(dplyr::all_of(platform_vars)) == 1], collapse = " + ")
) %>%
group_by(rep_label) %>%
filter(sum(wr_report) >= 20) %>%
ungroup()
lwd_data_rep
svy_breadth <- svydesign(
ids     = ~1,           # no clustering  (use ~psu_var if you have clusters)
strata  = NULL,         # no stratification (use ~strata_var if applicable)
weights = ~wr_report,      # <-- replace 'weight' with your weight variable name
data    = lwd_data,
nest    = TRUE
)
svy_rep <- svydesign(
ids     = ~1,           # no clustering  (use ~psu_var if you have clusters)
strata  = NULL,         # no stratification (use ~strata_var if applicable)
weights = ~wr_report,      # <-- replace 'weight' with your weight variable name
data    = lwd_data_rep,
nest    = TRUE
)
base_model <- svyglm(polarization ~ age + gender + edu + employ + income_quantile + t_tvn + t_papern + t_broadcastn + t_magn + t_onlinen, family = quasibinomial(), design = svy_breadth)
summary(base_model)
exp(coef(base_model))
summ(base_model)
modelsummary(
list(
"Control Variables" = base_model,
"Platform Breadth" = breadth_model,
"Social Media Repertoire" = rep_model),
exponentiate = TRUE,
statistic = "({std.error})",
stars = c('*' = .05, '**' = .01, '***' = .001),
title = "Logistic Regression Results: Perceived Polarization (Odds Ratios)",
output = "polarization_models.html"
)
breadth_model <- svyglm(polarization ~ age + gender + edu + employ + income_quantile + t_tvn + t_papern + t_broadcastn + t_magn + t_onlinen + breadth, family = quasibinomial(), design = svy_breadth)
summary(breadth_model)
exp(coef(breadth_model))
summ(breadth_model)
rep_model <- svyglm(polarization ~ age + gender + edu + employ + income_quantile + t_tvn + t_papern + t_broadcastn + t_magn + t_onlinen + rep_label, family = quasibinomial(), design = svy_rep)
summary(rep_model)
exp(coef(rep_model))
summ(rep_model)
modelsummary(
list(
"Control Variables" = base_model,
