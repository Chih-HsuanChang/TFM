summary(demo_model)
# 3. Extract Odds Ratios and their CIs (Best for interpretation)
# Setting exponentiate = TRUE automatically transforms the estimate and the CI bounds
tidy_odds_ratios <- tidy(jb_model, conf.int = TRUE, exponentiate = TRUE) %>%
select(term, estimate, conf.low, conf.high, p.value)
jb_model <- svyglm(polarization ~ breadth, family = quasibinomial(), design = svy_breadth)
