print(tidy_odds_ratios)
model_1 <- svyglm(polarization ~ breadth, family = quasibinomial(), design = svy_breadth)
model_2 <- svyglm(polarization ~ age + gender + edu + employ + income_quantile + breadth, family = quasibinomial(), design = svy_breadth)
model_3 <- svyglm(polarization ~ age + gender + edu + employ + income_quantile + t_tvn + t_papern + t_broadcastn + t_magn + t_onlinen + breadth, family = quasibinomial(), design = svy_breadth)
model_4 <- svyglm(polarization ~ age + gender + edu + employ + income_quantile + t_tvn + t_papern + t_broadcastn + t_magn + t_onlinen + rep_label+breadth, family = quasibinomial(), design = svy_rep)
summary(rep_model)
my_models <- list(
"Model 1 (Base)" = model_1,
"Model 2 (Demographics)" = model_2,
"Model 3 (Trust in News)" = model_3,
"Model 4 (Repertoire)" = model_4,
)
my_models <- list(
"Model 1 (Base)" = model_1,
"Model 2 (Demographics)" = model_2,
"Model 3 (Trust in News)" = model_3,
"Model 4 (Repertoire)" = model_4
)
# 2. Iterate, tidy, and bind them together
combined_results <- map_dfr(my_models, function(mod) {
# If dealing with logistic regression, add exponentiate = TRUE
tidy(mod, conf.int = TRUE)
}, .id = "model_name") %>%
# 3. Select only the columns you care about
select(model_name, term, estimate, conf.low, conf.high, p.value)
print(combined_results)
# 2. Iterate, tidy, and bind them together
combined_results <- map_dfr(my_models, function(mod) {
# If dealing with logistic regression, add exponentiate = TRUE
tidy(mod, conf.int = TRUE, exponentiate = TRUE)
}, .id = "model_name") %>%
# 3. Select only the columns you care about
select(model_name, term, estimate, conf.low, conf.high, p.value)
print(combined_results)
modelsummary(
my_models,
estimate = "{estimate} [{conf.low}, {conf.high}]",
statistic = "p = {p.value}", # Puts the p-value in the row directly beneath the estimate
conf_level = 0.95,
stars = TRUE # Optional: Adds significance stars
)
modelsummary(
my_models,
exponentiate = TRUE,
estimate = "{estimate} [{conf.low}, {conf.high}]",
statistic = NULL, # Puts the p-value in the row directly beneath the estimate
conf_level = 0.95,
stars = TRUE # Optional: Adds significance stars
)
